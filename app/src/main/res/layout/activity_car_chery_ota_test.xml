<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/connectCarService"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Connect"
                android:textSize="28sp"
                app:layout_constraintEnd_toStartOf="@id/disconnectCarService"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/disconnectCarService"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="Disconnect"
                android:textSize="28sp"
                app:layout_constraintBottom_toBottomOf="@id/connectCarService"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/connectCarService"
                app:layout_constraintTop_toTopOf="@id/connectCarService" />

            <com.google.android.material.card.MaterialCardView
                style="@style/JoelCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="32dp"
                app:layout_constraintTop_toBottomOf="@id/connectCarService">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/specialParent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:padding="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/subscribe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Subscribe"
                        android:textSize="28sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/unsubscribe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:text="Unsubscribe"
                        android:textSize="28sp"
                        app:layout_constraintStart_toEndOf="@id/subscribe"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/getSecureInfoSync"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="GetSecureSync"
                        android:textSize="28sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/subscribe" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/getSecureInfoAsync"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:text="GetSecureAsync"
                        android:textSize="28sp"
                        app:layout_constraintStart_toEndOf="@id/getSecureInfoSync"
                        app:layout_constraintTop_toBottomOf="@id/subscribe" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/getAuthInfoSync"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:text="GetAuthSync"
                        android:textSize="28sp"
                        app:layout_constraintStart_toEndOf="@id/getSecureInfoAsync"
                        app:layout_constraintTop_toBottomOf="@id/subscribe" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/getAuthInfoAsync"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:text="GetAuthAsync"
                        android:textSize="28sp"
                        app:layout_constraintStart_toEndOf="@id/getAuthInfoSync"
                        app:layout_constraintTop_toBottomOf="@id/subscribe" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sendPowerOn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="SendPowerOn"
                        android:textSize="28sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/getSecureInfoSync" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sendPowerOff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:text="sendPowerOff"
                        android:textSize="28sp"
                        app:layout_constraintStart_toEndOf="@id/sendPowerOn"
                        app:layout_constraintTop_toBottomOf="@id/getSecureInfoSync" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sendPowerContinuous"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:text="sendPowerContinuous"
                        android:textSize="28sp"
                        app:layout_constraintStart_toEndOf="@id/sendPowerOff"
                        app:layout_constraintTop_toBottomOf="@id/getSecureInfoSync" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>