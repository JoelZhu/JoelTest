<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/connectCarService"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Connect"
        android:textSize="28sp"
        app:layout_constraintEnd_toStartOf="@id/disconnectCarService"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/disconnectCarService"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:text="Disconnect"
        android:textSize="28sp"
        app:layout_constraintBottom_toBottomOf="@id/connectCarService"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/connectCarService"
        app:layout_constraintTop_toTopOf="@id/connectCarService" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/subscribePropertyContainer"
        style="@style/JoelCardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/connectCarService">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/notifyPhoningEnter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="Phone enter"
                android:textSize="28sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/notifyPhoningExit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:enabled="false"
                android:text="Phone exit"
                android:textSize="28sp"
                app:layout_constraintBottom_toBottomOf="@id/notifyPhoningEnter"
                app:layout_constraintStart_toEndOf="@id/notifyPhoningEnter"
                app:layout_constraintTop_toTopOf="@id/notifyPhoningEnter" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/subscribeKeyEvent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:enabled="false"
                android:text="Subscribe"
                android:textSize="28sp"
                app:layout_constraintEnd_toStartOf="@id/unsubscribeKeyEvent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/notifyPhoningEnter" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/unsubscribeKeyEvent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:enabled="false"
                android:text="Unsubscribe"
                android:textSize="28sp"
                app:layout_constraintBottom_toBottomOf="@id/subscribeKeyEvent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/subscribeKeyEvent"
                app:layout_constraintTop_toTopOf="@id/subscribeKeyEvent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/onEventChange"
                android:layout_width="match_parent"
                android:layout_height="500dp"
                android:layout_marginTop="32dp"
                android:fadeScrollbars="false"
                android:gravity="center|start"
                android:scrollbarAlwaysDrawVerticalTrack="true"
                android:scrollbarStyle="insideInset"
                android:scrollbars="vertical"
                android:textSize="26sp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/subscribeKeyEvent"
                tools:text="Test" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>